<mvc:View xmlns:layout="sap.ui.layout"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  controllerName="com.myorg.myapp.controller.Launchpad">
  <Page class="sapUiContentPadding" title= "Launchpad">
  <layout:Grid >
    <GenericTile
      header="Tile 1"
      subheader="Tile description"
      press="onTilePress">
      <tileContent>
        <TileContent>
          <content>
            <Text text="Some content for Tile 1" />
          </content>
        </TileContent>
      </tileContent>
    </GenericTile>

    <GenericTile
      header="Tile 2"
      subheader="Tile description"
      press="onTilePress">
      <tileContent>
        <TileContent>
          <content>
            <Text text="Some content for Tile 2" />
          </content>
        </TileContent>
      </tileContent>
    </GenericTile>
    
  </layout:Grid>
  </Page>
  
  

</mvc:View>
